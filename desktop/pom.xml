<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.lagless</groupId><artifactId>lagless-ssh</artifactId><version>0.2.0-rc.8.23</version></parent>
  <artifactId>lagless-desktop</artifactId>
  <name>Lagless optional desktop client</name>
  <properties><lagless.distribution>desktop</lagless.distribution></properties>
  <dependencies>
    <dependency><groupId>dev.lagless</groupId><artifactId>lagless-core</artifactId></dependency>
    <dependency><groupId>dev.lagless</groupId><artifactId>lagless-cli</artifactId></dependency>
    <dependency><groupId>com.formdev</groupId><artifactId>flatlaf</artifactId></dependency>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.8</version></dependency>
    <dependency><groupId>org.graalvm.sdk</groupId><artifactId>nativeimage</artifactId><version>25.0.0</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.apache.sshd</groupId><artifactId>sshd-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.apache.sshd</groupId><artifactId>sshd-sftp</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <finalName>lagless-desktop</finalName>
    <resources>
      <resource><directory>src/main/resources</directory><excludes><exclude>dev/lagless/desktop/build.properties</exclude></excludes></resource>
      <resource><directory>src/main/resources</directory><filtering>true</filtering><includes><include>dev/lagless/desktop/build.properties</include></includes></resource>
    </resources>
    <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
      <executions><execution><id>default</id><configuration><filters combine.self="override"><filter><artifact>*:*</artifact><excludes>
        <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
        <!-- A shaded SDK has no module-info; Native Image supplies its own SDK modules. -->
        <exclude>META-INF/native-image/org.graalvm.sdk/**</exclude>
      </excludes></filter>
      <filter><artifact>org.graalvm.sdk:nativeimage</artifact><includes><include>org/graalvm/nativeimage/ImageInfo.class</include></includes></filter>
      <filter><artifact>org.graalvm.sdk:word</artifact><excludes><exclude>**</exclude></excludes></filter>
      </filters></configuration></execution></executions>
    </plugin></plugins>
  </build>
</project>
